# Backend only. Copy to runtime/.env; restart office-node after editing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 1: seed company/accounts on startup; 0: manual setup or prepare a member node.
MONASTACK_SEED_COMPANY=1

# Listener override; local_office.py explicitly uses 0.0.0.0 for both nodes.
# MONASTACK_BIND_HOST=127.0.0.1

# Members use the master for office data, presence and media tickets.
MONASTACK_WORKSPACE_MODE=shared

# Server only. local_office.py sets these automatically. Members need neither
# this directory nor homeserver credentials. Unset DIR to disable Matrix chat.
# MONASTACK_MATRIX_DIR=/absolute/path/to/runtime/matrix
# MONASTACK_MATRIX_PUBLIC_URL=http://127.0.0.1:8008
# Gateway -> authority policy (same host, always loopback).
# MONASTACK_MATRIX_AUTHORITY_URL=http://127.0.0.1:47830
